@page "/TVShowView/{MediaId:int}"
@using TrackMyMedia.Shared.Models
@inject HttpClient Http
@inject NavigationManager Navigation

<h3>TV Show Details</h3>

@if (tvShow == null)
{
    <p><em>Loading TV Show details...</em></p>
}
else
{
    @if (!isEditing)
    {
        <!-- View Mode -->
        <div>
            <h4>@tvShow.Title</h4>
            <p><strong>Seasons:</strong> @tvShow.Seasons</p>
            <p><strong>Episodes:</strong> @tvShow.Episodes</p>
            <p><strong>Genre:</strong> @tvShow.Genre</p>
            <p><strong>Audience Rating:</strong> @(tvShow.AudienceRating?.ToString("0.0") ?? "N/A")</p>
            <p><strong>Critic Rating:</strong> @(tvShow.CriticRating?.ToString("0.0") ?? "N/A")</p>
            <p><strong>Average Length:</strong> @(tvShow.AverageLength.HasValue ? $"{tvShow.AverageLength} min" : "N/A")</p>
            <p><strong>Time Spent:</strong> @(tvShow.TimeSpent.HasValue ? $"{tvShow.TimeSpent} min" : "N/A")</p>
            <p><strong>Media Type:</strong> @tvShow.MediaType</p>
            <p><strong>Date Added:</strong> @tvShow.DateAdded.ToShortDateString()</p>
            <p><strong>Description:</strong> @tvShow.Description</p>

            <button class="btn btn-primary" @onclick="StartEditing">Edit</button>
            <button class="btn btn-secondary" @onclick="GoBack">Back</button>
        </div>
    }
    else
    {
        <!-- Edit Mode -->
        <div>
            <h4>Edit TV Show</h4>
            <div class="mb-3">
                <label>Title:</label>
                <input class="form-control" @bind="tvShow.Title" />
            </div>
            <div class="mb-3">
                <label>Seasons:</label>
                <input type="number" class="form-control" @bind="tvShow.Seasons" />
            </div>
            <div class="mb-3">
                <label>Episodes:</label>
                <input type="number" class="form-control" @bind="tvShow.Episodes" />
            </div>
            <div class="mb-3">
                <label>Genre:</label>
                <input class="form-control" @bind="tvShow.Genre" />
            </div>
            <div class="mb-3">
                <label>Audience Rating:</label>
                <input type="number" step="0.1" class="form-control" @bind="tvShow.AudienceRating" />
            </div>
            <div class="mb-3">
                <label>Critic Rating:</label>
                <input type="number" step="0.1" class="form-control" @bind="tvShow.CriticRating" />
            </div>
            <div class="mb-3">
                <label>Average Length (min):</label>
                <input type="number" class="form-control" @bind="tvShow.AverageLength" />
            </div>
            <div class="mb-3">
                <label>Time Spent (min):</label>
                <input type="number" class="form-control" @bind="tvShow.TimeSpent" />
            </div>
            <div class="mb-3">
                <label>Description:</label>
                <textarea class="form-control" @bind="tvShow.Description"></textarea>
            </div>

            <button class="btn btn-success" @onclick="SaveChanges">Save</button>
            <button class="btn btn-danger" @onclick="CancelEditing">Cancel</button>
        </div>
    }
}

@code {
    [Parameter] public int MediaId { get; set; }
    private TVShowModel? tvShow;
    private bool isEditing = false;

    protected override async Task OnInitializedAsync()
    {
        tvShow = await Http.GetFromJsonAsync<TVShowModel>($"api/tvshow/{MediaId}");
    }

    private void StartEditing()
    {
        isEditing = true;
    }

    private async Task SaveChanges()
    {
        await Http.PutAsJsonAsync($"api/tvshow/{MediaId}", tvShow);
        isEditing = false;
    }

    private void CancelEditing()
    {
        isEditing = false;
    }

    private void GoBack()
    {
        Navigation.NavigateTo("/TVShows/TVShowList");
    }
}
