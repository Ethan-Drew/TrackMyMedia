@page "/TVShows/AddTVShow"
@using TrackMyMedia.Shared.Models
@inject HttpClient Http
@inject NavigationManager Navigation

<h3>Add TV Show</h3>

<EditForm Model="newTVShow" OnValidSubmit="HandleValidSubmit">
    <DataAnnotationsValidator />
    <ValidationSummary />

    <div class="form-group">
        <label for="title">Title</label>
        <InputText id="title" class="form-control" @bind-Value="newTVShow.Title" />
        <ValidationMessage For="() => newTVShow.Title" />
    </div>

    <div class="form-group">
        <label for="mediaType">Media Type</label>
        <InputText id="mediaType" class="form-control" @bind-Value="newTVShow.MediaType" readonly />
    </div>

    <div class="form-group">
        <label for="releaseDate">Release Date</label>
        <InputDate id="releaseDate" class="form-control" @bind-Value="newTVShow.ReleaseDate" />
        <ValidationMessage For="() => newTVShow.ReleaseDate" />
    </div>

    <div class="form-group">
        <label for="myRating">My Rating</label>
        <InputNumber id="myRating" class="form-control" @bind-Value="newTVShow.MyRating" />
        <ValidationMessage For="() => newTVShow.MyRating" />
    </div>

    <div class="form-group">
        <label for="timeSpent">Time Spent</label>
        <InputNumber id="timeSpent" class="form-control" @bind-Value="newTVShow.TimeSpent" />
        <ValidationMessage For="() => newTVShow.TimeSpent" />
    </div>

    <div class="form-group">
        <label for="genre">Genre</label>
        <InputText id="genre" class="form-control" @bind-Value="newTVShow.Genre" />
        <ValidationMessage For="() => newTVShow.Genre" />
    </div>

    <div class="form-group">
        <label for="description">Description</label>
        <InputTextArea id="description" class="form-control" @bind-Value="newTVShow.Description" />
        <ValidationMessage For="() => newTVShow.Description" />
    </div>

    <div class="form-group">
        <label for="audienceRating">Audience Rating</label>
        <InputNumber id="audienceRating" class="form-control" @bind-Value="newTVShow.AudienceRating" />
        <ValidationMessage For="() => newTVShow.AudienceRating" />
    </div>

    <div class="form-group">
        <label for="criticRating">Critic Rating</label>
        <InputNumber id="criticRating" class="form-control" @bind-Value="newTVShow.CriticRating" />
        <ValidationMessage For="() => newTVShow.CriticRating" />
    </div>

    <div class="form-group">
        <label for="averageLength">Average Length</label>
        <InputNumber id="averageLength" class="form-control" @bind-Value="newTVShow.AverageLength" />
        <ValidationMessage For="() => newTVShow.AverageLength" />
    </div>

    <div class="form-group">
        <label for="seasons">Seasons</label>
        <InputNumber id="seasons" class="form-control" @bind-Value="newTVShow.Seasons" />
        <ValidationMessage For="() => newTVShow.Seasons" />
    </div>

    <div class="form-group">
        <label for="episodes">Episodes</label>
        <InputNumber id="episodes" class="form-control" @bind-Value="newTVShow.Episodes" />
        <ValidationMessage For="() => newTVShow.Episodes" />
    </div>

    <button type="submit" class="btn btn-primary">Add TV Show</button>

    <!-- Back Button -->
    <button type="button" class="btn btn-secondary" @onclick="GoBack">Back</button>
</EditForm>

@code {
    private TVShowModel newTVShow = new TVShowModel { MediaType = "TV Show" };

    private async Task HandleValidSubmit()
    {
        var response = await Http.PostAsJsonAsync("api/tvshow", newTVShow);

        if (response.IsSuccessStatusCode)
        {
            Navigation.NavigateTo("/TVShows/TVShowList");
        }
        else
        {
            var errorMessage = await response.Content.ReadAsStringAsync();
        }
    }

    private void GoBack()
    {
        Navigation.NavigateTo("/TVShows/TVShowList");
    }
}
