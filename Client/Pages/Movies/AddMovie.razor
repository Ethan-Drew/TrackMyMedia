@page "/Movies/AddMovie"
@using TrackMyMedia.Shared.Models
@inject HttpClient Http
@inject NavigationManager Navigation

<h3>Add Movie</h3>

<EditForm Model="newMovie" OnValidSubmit="HandleValidSubmit">
    <DataAnnotationsValidator />
    <ValidationSummary />

    <div class="form-group">
        <label for="title">Title</label>
        <InputText id="title" class="form-control" @bind-Value="newMovie.Title" />
        <ValidationMessage For="() => newMovie.Title" />
    </div>

    <div class="form-group">
        <label for="releaseDate">Release Date</label>
        <InputDate id="releaseDate" class="form-control" @bind-Value="newMovie.ReleaseDate" />
        <ValidationMessage For="() => newMovie.ReleaseDate" />
    </div>

    <div class="form-group">
        <label for="myRating">My Rating</label>
        <InputNumber id="myRating" class="form-control" @bind-Value="newMovie.MyRating" />
        <ValidationMessage For="() => newMovie.MyRating" />
    </div>

    <div class="form-group">
        <label for="timeSpent">Time Spent</label>
        <InputNumber id="timeSpent" class="form-control" @bind-Value="newMovie.TimeSpent" />
        <ValidationMessage For="() => newMovie.TimeSpent" />
    </div>

    <div class="form-group">
        <label for="mediaType">Media Type</label>
        <InputText id="mediaType" class="form-control" @bind-Value="newMovie.MediaType" />
        <ValidationMessage For="() => newMovie.MediaType" />
    </div>

    <div class="form-group">
        <label for="director">Director</label>
        <InputText id="director" class="form-control" @bind-Value="newMovie.Director" />
        <ValidationMessage For="() => newMovie.Director" />
    </div>

    <div class="form-group">
        <label for="genre">Genre</label>
        <InputText id="genre" class="form-control" @bind-Value="newMovie.Genre" />
        <ValidationMessage For="() => newMovie.Genre" />
    </div>

    <div class="form-group">
        <label for="description">Description</label>
        <InputTextArea id="description" class="form-control" @bind-Value="newMovie.Description" />
        <ValidationMessage For="() => newMovie.Description" />
    </div>

    <div class="form-group">
        <label for="audienceRating">Audience Rating</label>
        <InputNumber id="audienceRating" class="form-control" @bind-Value="newMovie.AudienceRating" />
        <ValidationMessage For="() => newMovie.AudienceRating" />
    </div>

    <div class="form-group">
        <label for="criticRating">Critic Rating</label>
        <InputNumber id="criticRating" class="form-control" @bind-Value="newMovie.CriticRating" />
        <ValidationMessage For="() => newMovie.CriticRating" />
    </div>

    <div class="form-group">
        <label for="averageLength">Average Length</label>
        <InputNumber id="averageLength" class="form-control" @bind-Value="newMovie.AverageLength" />
        <ValidationMessage For="() => newMovie.AverageLength" />
    </div>

    <button type="submit" class="btn btn-primary">Add Movie</button>
</EditForm>

@code {
    private MovieModel newMovie = new MovieModel { };

    private async Task HandleValidSubmit()
    {
        // Send the movie data to the API (POST request)
        var response = await Http.PostAsJsonAsync("api/movie", newMovie);

        if (response.IsSuccessStatusCode)
        {
            // Redirect to the movie list page or show a success message
            Navigation.NavigateTo("/Movies");
        }
        else
        {
            // Handle errors (e.g., show a message)
            var errorMessage = await response.Content.ReadAsStringAsync();
            // Show error message (e.g., using a modal or alert)
        }
    }
}
