@page "/VideoGameView/{MediaId:int}"
@using TrackMyMedia.Shared.Models
@inject HttpClient Http
@inject NavigationManager Navigation

<h3>Video Game Details</h3>

@if (videoGame == null)
{
    <p><em>Loading video game details...</em></p>
}
else
{
    @if (!isEditing)
    {
        <!-- View Mode -->
        <div>
            <h4>@videoGame.Title</h4>
            <p><strong>Developer:</strong> @videoGame.Developer</p>
            <p><strong>Genre:</strong> @videoGame.Genre</p>
            <p><strong>Platform:</strong> @videoGame.Platform</p>
            <p><strong>Release Date:</strong> @(videoGame.ReleaseDate?.ToShortDateString() ?? "N/A")</p>
            <p><strong>My Rating:</strong> @(videoGame.MyRating?.ToString("0.0") ?? "N/A")</p>
            <p><strong>Audience Rating:</strong> @(videoGame.AudienceRating?.ToString("0.0") ?? "N/A")</p>
            <p><strong>Critic Rating:</strong> @(videoGame.CriticRating?.ToString("0.0") ?? "N/A")</p>
            <p><strong>Average Length:</strong> @(videoGame.AverageLength.HasValue ? $"{videoGame.AverageLength} min" : "N/A")</p>
            <p><strong>Time Spent:</strong> @(videoGame.TimeSpent.HasValue ? $"{videoGame.TimeSpent} min" : "N/A")</p>
            <p><strong>Media Type:</strong> @videoGame.MediaType</p>
            <p><strong>Date Added:</strong> @videoGame.DateAdded.ToShortDateString()</p>
            <p><strong>Description:</strong> @videoGame.Description</p>

            <button class="btn btn-primary" @onclick="StartEditing">Edit</button>
            <button class="btn btn-secondary" @onclick="GoBack">Back</button>
        </div>
    }
    else
    {
        <!-- Edit Mode -->
        <div>
            <h4>Edit Video Game</h4>
            <div class="mb-3">
                <label>Title:</label>
                <input class="form-control" @bind="videoGame.Title" />
            </div>
            <div class="mb-3">
                <label>Developer:</label>
                <input class="form-control" @bind="videoGame.Developer" />
            </div>
            <div class="mb-3">
                <label>Platform:</label>
                <input class="form-control" @bind="videoGame.Platform" />
            </div>
            <div class="mb-3">
                <label>Genre:</label>
                <input class="form-control" @bind="videoGame.Genre" />
            </div>
            <div class="mb-3">
                <label>Release Date:</label>
                <input type="date" class="form-control" @bind="videoGame.ReleaseDate" />
            </div>
            <div class="mb-3">
                <label>My Rating:</label>
                <input type="number" step="0.1" class="form-control" @bind="videoGame.MyRating" />
            </div>
            <div class="mb-3">
                <label>Audience Rating:</label>
                <input type="number" step="0.1" class="form-control" @bind="videoGame.AudienceRating" />
            </div>
            <div class="mb-3">
                <label>Critic Rating:</label>
                <input type="number" step="0.1" class="form-control" @bind="videoGame.CriticRating" />
            </div>
            <div class="mb-3">
                <label>Average Length (min):</label>
                <input type="number" class="form-control" @bind="videoGame.AverageLength" />
            </div>
            <div class="mb-3">
                <label>Time Spent (min):</label>
                <input type="number" class="form-control" @bind="videoGame.TimeSpent" />
            </div>
            <div class="mb-3">
                <label>Description:</label>
                <textarea class="form-control" @bind="videoGame.Description"></textarea>
            </div>

            <button class="btn btn-success" @onclick="SaveChanges">Save</button>
            <button class="btn btn-danger" @onclick="CancelEditing">Cancel</button>
        </div>
    }
}

@code {
    [Parameter] public int MediaId { get; set; }
    private VideoGameModel? videoGame;
    private bool isEditing = false;

    protected override async Task OnInitializedAsync()
    {
        videoGame = await Http.GetFromJsonAsync<VideoGameModel>($"api/videoGame/{MediaId}");
    }

    private void StartEditing()
    {
        isEditing = true;
    }

    private async Task SaveChanges()
    {
        await Http.PutAsJsonAsync($"api/videoGame/{MediaId}", videoGame);
        isEditing = false;
    }

    private void CancelEditing()
    {
        isEditing = false;
    }

    private void GoBack()
    {
        Navigation.NavigateTo("/VideoGames/VideoGameList");
    }
}
