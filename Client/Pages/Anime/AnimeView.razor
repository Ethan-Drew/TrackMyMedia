@page "/AnimeView/{MediaId:int}"
@using TrackMyMedia.Shared.Models
@inject HttpClient Http
@inject NavigationManager Navigation

<h3>Anime Details</h3>

@if (anime == null)
{
    <p><em>Loading anime details...</em></p>
}
else
{
    @if (!isEditing)
    {
        <!-- View Mode -->
        <div>
            <h4>@anime.Title</h4>
            <p><strong>Studio:</strong> @anime.Studio</p>
            <p><strong>Release Date:</strong> @(anime.ReleaseDate?.ToShortDateString() ?? "N/A")</p>
            <p><strong>Episode Count:</strong> @anime.EpisodeCount</p>
            <p><strong>Season Count:</strong> @anime.SeasonCount</p>
            <p><strong>My Rating:</strong> @(anime.MyRating?.ToString("0.0") ?? "N/A")</p>
            <p><strong>Audience Rating:</strong> @(anime.AudienceRating?.ToString("0.0") ?? "N/A")</p>
            <p><strong>Critic Rating:</strong> @(anime.CriticRating?.ToString("0.0") ?? "N/A")</p>
            <p><strong>Average Length:</strong> @(anime.AverageLength.HasValue ? $"{anime.AverageLength} min" : "N/A")</p>
            <p><strong>Time Spent:</strong> @(anime.TimeSpent.HasValue ? $"{anime.TimeSpent} min" : "N/A")</p>
            <p><strong>Date Added:</strong> @anime.DateAdded.ToShortDateString()</p>
            <p><strong>Description:</strong> @anime.Description</p>

            <button class="btn btn-primary" @onclick="StartEditing">Edit</button>
            <button class="btn btn-secondary" @onclick="GoBack">Back</button>
        </div>
    }
    else
    {
        <!-- Edit Mode -->
        <div>
            <h4>Edit Anime</h4>
            <div class="mb-3">
                <label>Title:</label>
                <input class="form-control" @bind="anime.Title" />
            </div>
            <div class="mb-3">
                <label>Studio:</label>
                <input class="form-control" @bind="anime.Studio" />
            </div>
            <div class="mb-3">
                <label>Genre:</label>
                <input class="form-control" @bind="anime.MediaType" />
            </div>
            <div class="mb-3">
                <label>Release Date:</label>
                <input type="date" class="form-control" @bind="anime.ReleaseDate" />
            </div>
            <div class="mb-3">
                <label>Episode Count:</label>
                <input type="number" class="form-control" @bind="anime.EpisodeCount" />
            </div>
            <div class="mb-3">
                <label>Season Count:</label>
                <input type="number" class="form-control" @bind="anime.SeasonCount" />
            </div>
            <div class="mb-3">
                <label>My Rating:</label>
                <input type="number" step="0.1" class="form-control" @bind="anime.MyRating" />
            </div>
            <div class="mb-3">
                <label>Audience Rating:</label>
                <input type="number" step="0.1" class="form-control" @bind="anime.AudienceRating" />
            </div>
            <div class="mb-3">
                <label>Critic Rating:</label>
                <input type="number" step="0.1" class="form-control" @bind="anime.CriticRating" />
            </div>
            <div class="mb-3">
                <label>Average Length (min):</label>
                <input type="number" class="form-control" @bind="anime.AverageLength" />
            </div>
            <div class="mb-3">
                <label>Time Spent (min):</label>
                <input type="number" class="form-control" @bind="anime.TimeSpent" />
            </div>
            <div class="mb-3">
                <label>Description:</label>
                <textarea class="form-control" @bind="anime.Description"></textarea>
            </div>

            <button class="btn btn-success" @onclick="SaveChanges">Save</button>
            <button class="btn btn-danger" @onclick="CancelEditing">Cancel</button>
        </div>
    }
}

@code {
    [Parameter] public int MediaId { get; set; }
    private AnimeModel? anime;
    private bool isEditing = false;

    protected override async Task OnInitializedAsync()
    {
        anime = await Http.GetFromJsonAsync<AnimeModel>($"api/anime/{MediaId}");
    }

    private void StartEditing()
    {
        isEditing = true;
    }

    private async Task SaveChanges()
    {
        await Http.PutAsJsonAsync($"api/anime/{MediaId}", anime);
        isEditing = false;
    }

    private void CancelEditing()
    {
        isEditing = false;
    }

    private void GoBack()
    {
        Navigation.NavigateTo("/Anime/AnimeList");
    }
}