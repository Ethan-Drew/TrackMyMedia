@page "/Books/AddBook"
@using TrackMyMedia.Shared.Models
@inject HttpClient Http
@inject NavigationManager Navigation

<h3>Add Book</h3>

<EditForm Model="newBook" OnValidSubmit="HandleValidSubmit">
    <DataAnnotationsValidator />
    <ValidationSummary />

    <div class="form-group">
        <label for="title">Title</label>
        <InputText id="title" class="form-control" @bind-Value="newBook.Title" />
        <ValidationMessage For="() => newBook.Title" />
    </div>

    <div class="form-group">
        <label for="mediaType">Media Type</label>
        <InputText id="mediaType" class="form-control" @bind-Value="newBook.MediaType" readonly />
    </div>

    <div class="form-group">
        <label for="releaseDate">Release Date</label>
        <InputDate id="releaseDate" class="form-control" @bind-Value="newBook.ReleaseDate" />
        <ValidationMessage For="() => newBook.ReleaseDate" />
    </div>

    <div class="form-group">
        <label for="myRating">My Rating</label>
        <InputNumber id="myRating" class="form-control" @bind-Value="newBook.MyRating" />
        <ValidationMessage For="() => newBook.MyRating" />
    </div>

    <div class="form-group">
        <label for="timeSpent">Time Spent</label>
        <InputNumber id="timeSpent" class="form-control" @bind-Value="newBook.TimeSpent" />
        <ValidationMessage For="() => newBook.TimeSpent" />
    </div>

    <div class="form-group">
        <label for="author">Author</label>
        <InputText id="author" class="form-control" @bind-Value="newBook.Author" />
        <ValidationMessage For="() => newBook.Author" />
    </div>

    <div class="form-group">
        <label for="genre">Genre</label>
        <InputText id="genre" class="form-control" @bind-Value="newBook.Genre" />
        <ValidationMessage For="() => newBook.Genre" />
    </div>

    <div class="form-group">
        <label for="isbn">ISBN</label>
        <InputText id="isbn" class="form-control" @bind-Value="newBook.ISBN" />
        <ValidationMessage For="() => newBook.ISBN" />
    </div>

    <div class="form-group">
        <label for="description">Description</label>
        <InputTextArea id="description" class="form-control" @bind-Value="newBook.Description" />
        <ValidationMessage For="() => newBook.Description" />
    </div>

    <div class="form-group">
        <label for="audienceRating">Audience Rating</label>
        <InputNumber id="audienceRating" class="form-control" @bind-Value="newBook.AudienceRating" />
        <ValidationMessage For="() => newBook.AudienceRating" />
    </div>

    <div class="form-group">
        <label for="criticRating">Critic Rating</label>
        <InputNumber id="criticRating" class="form-control" @bind-Value="newBook.CriticRating" />
        <ValidationMessage For="() => newBook.CriticRating" />
    </div>

    <div class="form-group">
        <label for="averageLength">Average Length</label>
        <InputNumber id="averageLength" class="form-control" @bind-Value="newBook.AverageLength" />
        <ValidationMessage For="() => newBook.AverageLength" />
    </div>

    <button type="submit" class="btn btn-primary">Add Book</button>

    <!-- Back Button -->
    <button type="button" class="btn btn-secondary" @onclick="GoBack">Back</button>
</EditForm>

@code {
    private BookModel newBook = new BookModel { MediaType = "Book" };

    private async Task HandleValidSubmit()
    {
        var response = await Http.PostAsJsonAsync("api/book", newBook);

        if (response.IsSuccessStatusCode)
        {
            Navigation.NavigateTo("/Books/BookList");
        }
        else
        {
            var errorMessage = await response.Content.ReadAsStringAsync();
        }
    }

    private void GoBack()
    {
        Navigation.NavigateTo("/Books/BookList");
    }
}
