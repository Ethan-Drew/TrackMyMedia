@page "/Comics/AddComic"
@using TrackMyMedia.Shared.Models
@inject HttpClient Http
@inject NavigationManager Navigation

<h3>Add Comic</h3>

<EditForm Model="newComic" OnValidSubmit="HandleValidSubmit">
    <DataAnnotationsValidator />
    <ValidationSummary />

    <div class="form-group">
        <label for="title">Title</label>
        <InputText id="title" class="form-control" @bind-Value="newComic.Title" />
        <ValidationMessage For="() => newComic.Title" />
    </div>

    <div class="form-group">
        <label for="mediaType">Media Type</label>
        <InputText id="mediaType" class="form-control" @bind-Value="newComic.MediaType" readonly />
    </div>

    <div class="form-group">
        <label for="releaseDate">Release Date</label>
        <InputDate id="releaseDate" class="form-control" @bind-Value="newComic.ReleaseDate" />
        <ValidationMessage For="() => newComic.ReleaseDate" />
    </div>

    <div class="form-group">
        <label for="myRating">My Rating</label>
        <InputNumber id="myRating" class="form-control" @bind-Value="newComic.MyRating" />
        <ValidationMessage For="() => newComic.MyRating" />
    </div>

    <div class="form-group">
        <label for="timeSpent">Time Spent</label>
        <InputNumber id="timeSpent" class="form-control" @bind-Value="newComic.TimeSpent" />
        <ValidationMessage For="() => newComic.TimeSpent" />
    </div>

    <div class="form-group">
        <label for="publisher">Publisher</label>
        <InputText id="publisher" class="form-control" @bind-Value="newComic.Publisher" />
        <ValidationMessage For="() => newComic.Publisher" />
    </div>

    <div class="form-group">
        <label for="issueNumber">Issue Number</label>
        <InputNumber id="issueNumber" class="form-control" @bind-Value="newComic.IssueNumber" />
        <ValidationMessage For="() => newComic.IssueNumber" />
    </div>

    <div class="form-group">
        <label for="description">Description</label>
        <InputTextArea id="description" class="form-control" @bind-Value="newComic.Description" />
        <ValidationMessage For="() => newComic.Description" />
    </div>

    <div class="form-group">
        <label for="audienceRating">Audience Rating</label>
        <InputNumber id="audienceRating" class="form-control" @bind-Value="newComic.AudienceRating" />
        <ValidationMessage For="() => newComic.AudienceRating" />
    </div>

    <div class="form-group">
        <label for="criticRating">Critic Rating</label>
        <InputNumber id="criticRating" class="form-control" @bind-Value="newComic.CriticRating" />
        <ValidationMessage For="() => newComic.CriticRating" />
    </div>

    <div class="form-group">
        <label for="averageLength">Average Length</label>
        <InputNumber id="averageLength" class="form-control" @bind-Value="newComic.AverageLength" />
        <ValidationMessage For="() => newComic.AverageLength" />
    </div>

    <button type="submit" class="btn btn-primary">Add Comic</button>

    <!-- Back Button -->
    <button type="button" class="btn btn-secondary" @onclick="GoBack">Back</button>
</EditForm>

@code {
    private ComicModel newComic = new ComicModel { MediaType = "Comic" };

    private async Task HandleValidSubmit()
    {
        var response = await Http.PostAsJsonAsync("api/comic", newComic);

        if (response.IsSuccessStatusCode)
        {
            Navigation.NavigateTo("/Comics/ComicList");
        }
        else
        {
            var errorMessage = await response.Content.ReadAsStringAsync();
        }
    }

    private void GoBack()
    {
        Navigation.NavigateTo("/Comics/ComicList");
    }
}
